{
  "name": "@product-rating/server",
  "version": "0.0.0",
  "private": true,
  "description": "Fastify API server for product-rating",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts serve",
    "build": "tsup",
    "start": "node dist/index.js serve",
    "migrate": "tsx src/index.ts migrate",
    "fsck": "tsx src/index.ts fsck",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^9.3.0",
    "@node-rs/argon2": "^2.1.0",
    "@product-rating/shared": "*",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "sharp": "^0.35.3",
    "smol-toml": "^1.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "drizzle-kit": "^0.31.10",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12"
  }
}
