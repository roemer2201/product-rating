{
  "name": "product-rating",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hostable web app for recording products by EAN with a photo and a rating",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently --names api,web --prefix-colors blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev --workspace @product-rating/server",
    "dev:web": "npm run dev --workspace @product-rating/web",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start --workspace @product-rating/server",
    "migrate": "npm run migrate --workspace @product-rating/server",
    "fsck": "npm run fsck --workspace @product-rating/server",
    "db:generate": "npm run db:generate --workspace @product-rating/server",
    "package:deb": "bash packaging/build-deb.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
